# Copy this file to .env and fill in real values before going live.

# Leave empty to run the shop in test mode (checkout auto-completes,
# no real payment). Set this once you have a Mollie account to enable
# real iDEAL/card payments — get a live key at https://my.mollie.com
MOLLIE_API_KEY=

# Port the server listens on.
PORT=3000
